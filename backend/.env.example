# Copy this file to ".env" (same folder) and fill in your real values.
# .env must NEVER be committed to git - it's already in .gitignore.

# --- Database ---
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database>
# Replace YOUR_PASSWORD_HERE with your actual MySQL root password.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD_HERE@localhost:3306/mindguard_db

# --- JWT Auth ---
# Generate a real random secret for this - do not use this example value.
# Quick way to generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- ML ---
ML_MODEL_PATH=../ml/artifacts/risk_model.joblib